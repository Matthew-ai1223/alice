{
  "version": 2,
  "framework": null,
  "installCommand": "npm install && npm --prefix server install",
  "buildCommand": "npm --prefix server run build && node scripts/prepare-public.mjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ]
}
